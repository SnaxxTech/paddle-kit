{
  "name": "paddle-kit",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "bin": {
    "paddle-kit-catalog": "./dist/catalog/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "default": "./dist/memory/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "default": "./dist/sqlite/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./reconcile": {
      "types": "./dist/reconcile/index.d.ts",
      "default": "./dist/reconcile/index.js"
    },
    "./plan": {
      "types": "./dist/plan/index.d.ts",
      "default": "./dist/plan/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:pg": "vitest run tests/pg-concurrency.test.ts",
    "typecheck": "tsc --noEmit",
    "check:edge": "node scripts/check-edge.mjs",
    "smoke": "node scripts/smoke-pack.mjs"
  },
  "peerDependencies": {
    "@paddle/paddle-js": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@paddle/paddle-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@electric-sql/pglite": "^0.5.10",
    "@paddle/paddle-js": "^1.6.5",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "better-sqlite3": "^12.11.1",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "8.16.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
